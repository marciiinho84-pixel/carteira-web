minhacarteira.duckdns.org {

    # MCP — autenticado por Bearer token
    handle /mcp* {
        @no_auth {
            not header Authorization "Bearer {env.MCP_TOKEN}"
        }
        respond @no_auth 401

        reverse_proxy mcp:8001
    }

    # NextAuth — OAuth callbacks e session API (Next.js)
    handle /api/auth* {
        reverse_proxy nextjs:3000
    }

    # API REST FastAPI — autenticada por JWT
    handle /api* {
        reverse_proxy backend:8000
    }

    # Streamlit (legado) — acessível em /streamlit/*
    handle /streamlit* {
        basic_auth {
            marcio $2a$14$Ju7nt6OFddcyMf9JxcGm3eOQD/avQ61dKGWVdF4g2Qs/Y5dUXyAH6
        }
        uri strip_prefix /streamlit
        reverse_proxy frontend:8501
    }

    # Next.js — app principal
    handle {
        reverse_proxy nextjs:3000
    }
}
